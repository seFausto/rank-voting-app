@page "/new-ranking"
@using RankedChoiceVotingApp.Classes
@using RankedChoiceVotingApp.Services
@inject IApiService _apiService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>New Ranking</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">New Ranking</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ranking Name</label>
                    <input class="form-control" placeholder="e.g. Best Pizza Toppings" @bind="_rankingName" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Candidates</label>
                    <div class="input-group">
                        <input class="form-control" placeholder="Enter a candidate" @bind="_newCandidate" @bind:event="oninput" @onkeyup="HandleCandidateKeyUp" />
                        <button class="btn btn-outline-primary" @onclick="AddCandidate">Add</button>
                    </div>
                </div>

                @if (_candidates.Count > 0)
                {
                    <ul class="list-group mb-3">
                        @foreach (var candidate in _candidates)
                        {
                            <li class="list-group-item">
                                <input class="form-control form-control-sm border-0 p-0" @bind="candidate.Name" />
                            </li>
                        }
                    </ul>
                }

                <button class="btn btn-primary w-100" @onclick="SubmitNewRanking" disabled="@(string.IsNullOrWhiteSpace(_rankingName) || _candidates.Count == 0)">
                    Submit Ranking
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_url))
        {
            <div class="alert alert-success mt-3" role="alert">
                <strong>Ranking created!</strong>
                <div class="input-group mt-2">
                    <input class="form-control font-monospace" value="@GetRankingUrl()" readonly />
                    <button class="btn btn-outline-success" @onclick="CopyLink">
                        @(_copied ? "Copied!" : "Copy")
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger mt-3" role="alert">@_error</div>
        }
    </div>
</div>

@code {
    private string? _newCandidate;
    private string? _rankingName;
    private string? _url;
    private string? _error;
    private bool _copied;


    private string _rankingId = string.Empty;
    public string RankingId
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_rankingId))
                _rankingId = Common.GenerateId();

            return _rankingId;
        }
    }

    private List<Candidate> _candidates = new();

    private void HandleCandidateKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddCandidate();
    }

    private void AddCandidate()
    {
        if (!string.IsNullOrWhiteSpace(_newCandidate))
        {
            Candidate candidate = new()
            {
                Name = _newCandidate,
                RankingId = RankingId
            };

            _candidates.Add(candidate);

            _newCandidate = string.Empty;
        }
    }

    private string GetRankingUrl() =>
        Navigation.ToAbsoluteUri($"/existing-ranking/{_url}").ToString();

    private async Task CopyLink()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", GetRankingUrl());
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task SubmitNewRanking()
    {
        if (string.IsNullOrWhiteSpace(_rankingName))
            return;

        _error = null;
        var rankId = await _apiService.SubmitRankingAsync(_rankingName, _candidates.Select(c => c.Name));

        if (string.IsNullOrWhiteSpace(rankId))
        {
            _error = "Failed to create ranking. Check the console for details.";            
        }
        else
        {
            _url = rankId;
            _rankingName = string.Empty;
            _rankingId = string.Empty;
        }
    }
}
