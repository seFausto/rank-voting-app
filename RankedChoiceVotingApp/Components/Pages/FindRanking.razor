@page "/find-ranking"
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Find Ranking</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">Find Ranking</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ranking ID</label>
                    <div class="input-group">
                        <input class="form-control font-monospace" placeholder="Enter ranking ID" @bind="_rankingId" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                        <button class="btn btn-primary" @onclick="GoToRanking" disabled="@string.IsNullOrWhiteSpace(_rankingId)">
                            View
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _rankingId;

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") GoToRanking();
    }

    private void GoToRanking()
    {
        if (!string.IsNullOrWhiteSpace(_rankingId))
            Navigation.NavigateTo($"/existing-ranking/{_rankingId.Trim()}");
    }
}
