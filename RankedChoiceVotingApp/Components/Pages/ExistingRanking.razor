@page "/existing-ranking/{existingRankingId}"
@using RankedChoiceVotingApp.Classes
@using System.Text.Json
@using System.Text
@using RankedChoiceVotingApp.Services
@inject IConfiguration configuration
@inject IApiService _apiService
@rendermode InteractiveServer


<PageTitle>Ranking @existingRankingId</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Candidates</h4>
                <span class="badge bg-secondary font-monospace">@existingRankingId</span>
            </div>
            <div class="card-body p-0">
                @if (_candidates == null)
                {
                    <div class="p-4 text-center text-muted">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Loading...
                    </div>
                }
                else if (_candidates.Count == 0)
                {
                    <div class="p-4 text-center text-muted">No candidates found for this ranking.</div>
                }
                else
                {
                    <ol class="list-group list-group-numbered list-group-flush">
                        @foreach (var candidate in _candidates)
                        {
                            <li class="list-group-item">@candidate</li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string existingRankingId { get; set; } = string.Empty;

    private List<string> _candidates = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var task = await _apiService.GetListOfCandidatesAsync(existingRankingId);

            _candidates = task.ToList();
        }
        catch (Exception e)
        {
            Console.WriteLine($"Request error: {e.Message}");
        }


        await base.OnInitializedAsync();

        return;
    }

}
